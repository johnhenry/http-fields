{
  "name": "@johnhenry/http-fields",
  "version": "0.0.0",
  "description": "Modern JavaScript library for parsing and serializing HTTP Structured Field Values (RFC 8941 & RFC 9651)",
  "main": "index.mjs",
  "type": "module",
  "types": "./types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "import": "./index.mjs"
    },
    "./headers": {
      "types": "./headers.d.ts",
      "import": "./headers.mjs"
    }
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "test:basic": "node --test test/test.mjs",
    "test:official": "node --test test/official-tests.mjs",
    "test:serialization": "node --test test/serialization-tests.mjs",
    "test:base32": "node --test test/base32.mjs",
    "test:watch": "node --test --watch test/*.mjs",
    "test:coverage": "node --test --experimental-test-coverage test/*.mjs",
    "example": "node examples/index.mjs",
    "examples": "for f in examples/0[1-6]*.mjs; do echo \"=== $f\"; node \"$f\" || exit 1; done",
    "example:01": "node examples/01-basic.mjs",
    "example:02": "node examples/02-http-headers.mjs",
    "example:03": "node examples/03-cookies.mjs",
    "example:04": "node examples/04-rfc9651.mjs",
    "example:05": "node examples/05-advanced.mjs",
    "example:06": "node examples/06-comparison.mjs"
  },
  "keywords": [
    "http",
    "headers",
    "structured-fields",
    "rfc8941",
    "rfc9651",
    "parsing",
    "serialization",
    "web-standards",
    "http-fields",
    "structured-headers",
    "javascript",
    "typescript",
    "zero-dependencies"
  ],
  "author": "John Henry <john@iamjohnhenry.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/http-fields.git"
  },
  "bugs": {
    "url": "https://github.com/johnhenry/http-fields/issues"
  },
  "homepage": "https://opensource.johnhenry.me/http-fields/",
  "files": [
    "index.mjs",
    "types.d.ts",
    "headers.mjs",
    "headers.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "devDependencies": {}
}
